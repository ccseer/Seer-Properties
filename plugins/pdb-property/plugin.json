{
  "schema_version": 1,
  "id": "io.1218.seer.pdb",
  "name": "PDB",
  "description": "Read-only summary of PDB debug symbol files: format version, GUID, architecture, symbol/type/source counts, largest object contributions.",
  "version": "1.0.0",
  "appMinVersion": "4.5.10",
  "backend": "process",
  "capabilities": ["property"],
  "extensions": ["pdb"],
  "invocations": {
    "property": {
      "command": "pdb_property.exe",
      "arguments": ["--input", "${input_file}", "--output", "${output_file}", "--output-dir", "${output_dir}"],
      "result_schema": 1,
      "timeout_ms": 300000,
      "success_exit_codes": [0]
    }
  }
}
