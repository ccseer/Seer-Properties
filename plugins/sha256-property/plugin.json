{
  "schema_version": 1,
  "id": "io.1218.seer.sha256-property",
  "name": "File Hashes",
  "description": "Computes file hashes for the current file (SHA-256 by default, more algorithms selectable via arguments).",
  "version": "1.1.0",
  "appMinVersion": "4.5.10",
  "backend": "process",
  "capabilities": ["property"],
  "extensions": ["${type_file}"],
  "invocations": {
    "property": {
      "command": "sha256_property.exe",
      "arguments": ["--input", "${input_file}", "--output", "${output_file}"],
      "result_schema": 1,
      "timeout_ms": 120000,
      "success_exit_codes": [0]
    }
  }
}
